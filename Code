<div style="font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; text-align:center; margin:40px 0;">
  <div style="display:flex; justify-content:center; align-items:center; gap:12px; margin-bottom:15px;">
    <input id="numL" type="number"
      style="width:200px; padding:10px; text-align:center; border-radius:10px; border:3px solid #ccc;
             font-size:16px; font-weight:700; color:#333; transition:all .25s;">
    <input id="numR" type="number"
      style="width:200px; padding:10px; text-align:center; border-radius:10px; border:3px solid #ccc;
             font-size:16px; font-weight:700; color:#333; transition:all .25s;">

    <div style="position:relative; display:flex; align-items:center;">
      <button id="checkBtn"
        style="width:52px; height:52px; border-radius:50%; border:none; background:#2c2c2c; color:white;
               cursor:pointer; display:flex; align-items:center; justify-content:center; transition:transform .2s;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
          <path d="M9 18l6-6-6-6" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <span id="verifyLabel"
        style="position:absolute; right:-90px; opacity:0; color:#2c2c2c; font-weight:700; font-size:16px;
               pointer-events:none; transition:opacity .3s, transform .3s; transform:translateX(-8px);">
        Verifica
      </span>
    </div>
  </div>

  <div style="width:400px; height:340px; margin:28px auto 0;">
    <svg viewBox="0 0 400 340" width="400" height="340">
      <rect x="140" y="280" width="120" height="20" fill="#2c2c2c" rx="4"/>
      <rect x="195" y="80" width="10" height="200" fill="#2c2c2c"/>

      <g transform="translate(200,85)">
        <g id="arm" style="transition: transform 1s cubic-bezier(.25,1.2,.3,1);">
          <rect x="-120" y="-6" width="240" height="12" rx="6" fill="#2c2c2c"/>

          <line x1="-80" y1="2" x2="-80" y2="70" stroke="#2c2c2c" stroke-width="6" stroke-linecap="round"/>
          <line x1="80" y1="2" x2="80" y2="70" stroke="#2c2c2c" stroke-width="6" stroke-linecap="round"/>

          <circle id="ballL" cx="-80" cy="58" r="18" fill="transparent"
            style="transition: all .4s ease; filter:none;"/>
          <circle id="ballR" cx="80" cy="58" r="18" fill="transparent"
            style="transition: all .4s ease; filter:none;"/>

          <path d="M-120,70 A40,40 0 0,0 -40,70" fill="#2c2c2c"/>
          <path d="M40,70 A40,40 0 0,0 120,70" fill="#2c2c2c"/>
        </g>

        <circle cx="0" cy="0" r="10" fill="#2c2c2c"/>
      </g>
    </svg>
  </div>
</div>

<script>
const btn = document.getElementById('checkBtn');
const label = document.getElementById('verifyLabel');
const numL = document.getElementById('numL');
const numR = document.getElementById('numR');
const arm = document.getElementById('arm');
const ballL = document.getElementById('ballL');
const ballR = document.getElementById('ballR');

function rotateArm(deg){
  arm.style.transform = `rotate(${deg}deg)`;
}

btn.onmouseenter = ()=>{ label.style.opacity=1; label.style.transform='translateX(0)'; };
btn.onmouseleave = ()=>{ label.style.opacity=0; label.style.transform='translateX(-8px)'; };

btn.onclick = ()=>{
  btn.style.transform='scale(.94)';
  setTimeout(()=>btn.style.transform='scale(1)',130);

  const vL = numL.value;
  const vR = numR.value;
  const nL = parseFloat(vL);
  const nR = parseFloat(vR);

  const both = vL!=='' && vR!=='';
  const equal = both && nL===nR;

  
  if(!vL && !vR){
    numL.style.borderColor='#ccc';
    numR.style.borderColor='#ccc';
    numL.style.color='#333';
    numR.style.color='#333';
  }else if(equal){
    numL.style.borderColor='#4CAF50';
    numR.style.borderColor='#4CAF50';
    numL.style.color='#4CAF50';
    numR.style.color='#4CAF50';
  }else{
    if(vL){ numL.style.borderColor='#f44336'; numL.style.color='#f44336'; }
    if(vR){ numR.style.borderColor='#f44336'; numR.style.color='#f44336'; }
  }

  function setBall(ball, active, equal){
    if(!active){
      ball.setAttribute('fill','transparent');
      ball.style.filter='none';
      ball.setAttribute('cy',58);
      return;
    }
    ball.setAttribute('cy',72);
    if(equal){
      ball.setAttribute('fill','#4CAF50');
      ball.style.filter='drop-shadow(0 0 8px #4CAF50)';
    }else{
      ball.setAttribute('fill','#f44336');
      ball.style.filter='drop-shadow(0 0 8px #f44336)';
    }
  }

  setBall(ballL, vL, equal);
  setBall(ballR, vR, equal);

  
  if(!vL && !vR) return rotateArm(0);
  if(vL && !vR) return rotateArm(-12);   
  if(vR && !vL) return rotateArm(12);    

  if(nL>nR) return rotateArm(-12);  
  if(nR>nL) return rotateArm(12);   

  return rotateArm(0);
};
</script>
